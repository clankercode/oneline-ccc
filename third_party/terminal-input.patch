+package uv
+
+import (
+	"context"
+	"io"
+	"strings"
+	"testing"
+	"time"
+)
+
+type eofSignalReader struct {
+	*strings.Reader
+	eof chan struct{}
+}
+
+func (r eofSignalReader) Read(buf []byte) (int, error) {
+	n, err := r.Reader.Read(buf)
+	if err == io.EOF {
+		close(r.eof)
+	}
+	return n, err
+}
